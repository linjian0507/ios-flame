+/* Read the exact PM8150L GPIO5 block named by the local overlay phandle.
+ * The vendor driver numbers PMIC GPIOs from one, so GPIO5 is peripheral
+ * 0xc400 on SID 4. Type/subtype and APID ownership must be observed before
+ * choosing a write recipe. Reads and owner lookup share the SPMI lock. */
+static void
+tp_pmic_gpio_diagnostic(void)
+{
+	static const uint16_t addr[] = {
+		0xc404, 0xc405, 0xc410, 0xc440, 0xc441, 0xc442,
+		0xc443, 0xc444, 0xc445, 0xc446,
+	};
+	unsigned apid = 0, owner = 0;
+	int rc = sweet_spmi_touch_gpio_owner(&apid, &owner);
+	if (rc) {
+		printf("SWEET S3706: PM8150L GPIO5 APID unavailable; read-only diagnosis stopped\n");
+		return;
+	}
+	printf("SWEET S3706: PM8150L GPIO5 sid=4 peripheral=0xc4 apid=%u owner=%u (read-only)\n",
+	    apid, owner);
+	for (unsigned i = 0; i < sizeof(addr) / sizeof(addr[0]); ++i) {
+		uint8_t value = 0;
+		rc = sweet_spmi_read(4, addr[i], &value);
+		printf("SWEET S3706: PM8150L GPIO5 reg=%#x rc=%d value=%#x\n",
+		    addr[i], rc, value);
+		if (rc) {
+			break; /* in particular, never reuse a poisoned APID */
+		}
+	}
+}
