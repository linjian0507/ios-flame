+/* Kept separate so the permitted read-only range can be tested on a host. */
+static bool
+sp_read_allowed(unsigned sid, unsigned addr)
+{
+	/* Existing SID 0 reads plus read-only diagnostics for the PCLM10
+	 * touch enable GPIO: PM8150L SID 4, physical gpio5 at 0xc400. */
+	if (addr > 0xffffu) {
+		return false;
+	}
+	unsigned peripheral = addr >> 8;
+	bool base_read = sid == 0 &&
+	    (peripheral == 0x08 || peripheral == 0x10 || peripheral == 0x11 ||
+	    peripheral == 0x12 || peripheral == 0x13 || peripheral == 0x48 ||
+	    peripheral == 0x60);
+	bool touch_gpio_read = sid == 4 && peripheral == 0xc4 &&
+	    ((addr & 0xffu) == 0x04u || (addr & 0xffu) == 0x05u ||
+	    (addr & 0xffu) == 0x10u ||
+	    ((addr & 0xffu) >= 0x40u && (addr & 0xffu) <= 0x46u));
+	return base_read || touch_gpio_read;
+}
