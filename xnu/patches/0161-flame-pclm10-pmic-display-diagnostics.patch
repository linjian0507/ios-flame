diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index a4e4d60..9348451 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -253,6 +253,89 @@ AppleCLCD::start(IOService *provider)
 
 static uint64_t sweet_fb_swap_count;
 
+/* Read-only paired samples for the opt-in CPU present diagnostic. They
+ * compare the same source/panel coordinates away from corner mattes;
+ * equal memory bytes do not establish what the physical panel shows. */
+static void
+sweet_fb_compare_cpu(const uint8_t *src, const uint8_t *dst,
+    uint32_t src_stride, uint32_t dst_stride, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h,
+    uint32_t panel_w, uint32_t panel_h, uint32_t corner_extent)
+{
+	static int enabled = -1;
+	static unsigned samples;
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("sweetfb_compare", &enabled, sizeof(enabled));
+	}
+	if (!enabled || samples >= 10 || w <= 0 || h <= 0 ||
+	    dx != 0 || dy != 0 || (uint32_t)w != panel_w ||
+	    (uint32_t)h != panel_h || corner_extent * 2u >= panel_h) {
+		return;
+	}
+	/* The first few swaps can be black. Keep the budget for meaningful
+	 * frames so late lock-screen presents are compared as well. */
+	uint32_t probe_min[3] = {255, 255, 255}, probe_max[3] = {0, 0, 0};
+	for (uint32_t y = panel_h / 4u; y < panel_h * 3u / 4u; y += 32u) {
+		const volatile uint8_t *row = src + (uint64_t)(sy + y) * src_stride + (uint64_t)sx * 4u;
+		for (uint32_t x = 0; x < panel_w; x += 32u) {
+			for (unsigned k = 0; k < 3; k++) {
+				uint32_t v = row[4u * x + k];
+				if (v < probe_min[k]) probe_min[k] = v;
+				if (v > probe_max[k]) probe_max[k] = v;
+			}
+		}
+	}
+	uint32_t max_delta = 0;
+	for (unsigned k = 0; k < 3; k++) {
+		uint32_t delta = probe_max[k] - probe_min[k];
+		if (delta > max_delta) max_delta = delta;
+	}
+	if (max_delta < 8) {
+		return;
+	}
+	/* Do not spend all ten samples on consecutive animation frames. */
+	static uint32_t eligible;
+	if ((eligible++ % 15u) != 0) {
+		return;
+	}
+	uint64_t checked = 0, mismatch = 0;
+	uint64_t rdiff = 0, bdiff = 0, swapped = 0, transparent = 0;
+	uint32_t minv[4] = {255, 255, 255, 255};
+	uint32_t maxv[4] = {0, 0, 0, 0};
+	uint32_t y0 = corner_extent;
+	uint32_t y1 = panel_h - corner_extent;
+	for (uint32_t y = y0; y < y1; y += 16) {
+		const volatile uint8_t *s = src + (uint64_t)(sy + y) * src_stride + (uint64_t)sx * 4u;
+		const volatile uint8_t *d = dst + (uint64_t)y * dst_stride;
+		for (uint32_t x = 0; x < panel_w; x += 16) {
+			uint8_t a0 = s[4u * x], a1 = s[4u * x + 1u];
+			uint8_t a2 = s[4u * x + 2u], a3 = s[4u * x + 3u];
+			uint8_t b0 = d[4u * x], b1 = d[4u * x + 1u];
+			uint8_t b2 = d[4u * x + 2u], b3 = d[4u * x + 3u];
+			const uint8_t p[4] = {a0, a1, a2, a3};
+			if (a3 != 255) transparent++;
+			for (unsigned k = 0; k < 4; k++) {
+				if (p[k] < minv[k]) minv[k] = p[k];
+				if (p[k] > maxv[k]) maxv[k] = p[k];
+			}
+			checked++;
+			if (a0 != b0 || a1 != b1 || a2 != b2 || a3 != b3) {
+				mismatch++;
+				if (a0 != b0) bdiff++;
+				if (a2 != b2) rdiff++;
+				if (a0 == b2 && a2 == b0 && a1 == b1 && a3 == b3) swapped++;
+			}
+		}
+	}
+	IOLog("SWEET FB: compare %u CPU source crop=%d,%d size=%dx%d stride=%u/%u "
+	    "grid=%llu mismatches=%llu bdiff=%llu rdiff=%llu rb-swapped=%llu nonopaque=%llu "
+	    "source-min=%u/%u/%u/%u max=%u/%u/%u/%u\n",
+	    samples++, sx, sy, w, h, src_stride, dst_stride,
+	    checked, mismatch, bdiff, rdiff, swapped, transparent,
+	    minv[0], minv[1], minv[2], minv[3], maxv[0], maxv[1], maxv[2], maxv[3]);
+}
