diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 03b1879..f14ab12 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -336,6 +336,7 @@ static struct {
 	uint32_t    resp_len, resp_ready;
 	uint32_t    rndis_filter;   /* OID_GEN_CURRENT_PACKET_FILTER */
 	bool        data_up;        /* RNDIS data path open (nonzero filter) */
+	bool        media_pending;  /* queue MEDIA_CONNECT after filter SET */
 	bool        notify_busy, notify_again;
 	/* serial console pipe (the ACM anchor's bulk IN, RNDIS mode):
 	 * slog_ready is set once the endpoint is configured; acm_dtr
@@ -675,9 +676,11 @@ ud_configure(void)
 #define RNDIS_MSG_SET         0x00000005u
 #define RNDIS_MSG_RESET       0x00000006u
 #define RNDIS_MSG_KEEPALIVE   0x00000008u
+#define RNDIS_MSG_INDICATE    0x00000007u
 #define RNDIS_MSG_C           0x80000000u
 #define RNDIS_STATUS_SUCCESS          0x00000000u
 #define RNDIS_STATUS_NOT_SUPPORTED    0xc00000bbu
+#define RNDIS_STATUS_MEDIA_CONNECT    0x4001000bu
 #define RNDIS_OID_SUPPORTED_LIST      0x00010101u
 #define RNDIS_OID_HARDWARE_STATUS     0x00010102u
 #define RNDIS_OID_MEDIA_SUPPORTED     0x00010103u
@@ -937,6 +940,7 @@ ud_rndis_command(const uint8_t *m, uint32_t len)
 			if (ud.rndis_filter && !ud.data_up) {
 				ud.data_up = true;
 				ud_link_event(true);
+				ud.media_pending = true;
 				printf("SWEET USB: rndis data path up\n");
 			}
 		} else if (oid == RNDIS_OID_802_3_MULTICAST_LIST) {
@@ -1036,6 +1040,22 @@ ud_setup(void)
 				n = ud.resp_len > length ? length : ud.resp_len;
 				memcpy(data, ud.resp, n);
 				ud.resp_ready = 0;
+				/* Linux f_rndis sends RNDIS_MSG_INDICATE(MEDIA_CONNECT)
+				 * when the link opens; Windows starts the receive
+				 * path from it even though the miniport is already Up. */
+				if (ud.media_pending) {
+					ud.media_pending = false;
+					bzero(ud.resp, 20);
+					ud_rndis_put32(ud.resp, RNDIS_MSG_INDICATE);
+					ud_rndis_put32(ud.resp + 4, 20);
+					ud_rndis_put32(ud.resp + 8, RNDIS_STATUS_MEDIA_CONNECT);
+					ud_rndis_put32(ud.resp + 12, 0);
+					ud_rndis_put32(ud.resp + 16, 0);
+					ud.resp_len = 20;
+					ud.resp_ready = 1;
+					ud_rndis_notify();
+					printf("SWEET USB: rndis media connect indication queued\n");
+				}
 			} else {
 				ok = false;   /* nothing queued: stall, as f_rndis does */
 			}
@@ -1418,7 +1438,10 @@ ud_if_create(void)
 		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
 		a->sin_len = sizeof(*a);
 		a->sin_family = AF_INET;
-		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		/* Limited broadcast: the host's DHCP client still has APIPA,
+		 * so a 192.168.7.255 destination is dropped by its IP stack.
+		 * 255.255.255.255 is accepted before an address exists. */
+		a->sin_addr.s_addr = htonl(0xffffffff);
 		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
 		sock_close(so);
 	}
