+		uint32_t boff = len >= 24 ? ud_rndis_get32(m + 20) : 0;
 		const uint8_t *b = m + 8 + boff;
 		uint32_t status = RNDIS_STATUS_SUCCESS;
 
 		if (oid == RNDIS_OID_CURRENT_PACKET_FILTER && blen >= 4 &&
-		    8 + boff + 4 <= len) {
+		    len >= 24 && 8 + boff + 4 <= len) {
