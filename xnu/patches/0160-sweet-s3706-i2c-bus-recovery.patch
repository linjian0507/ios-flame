index 7a0bde6..e3e510e 100644
--- a/bsd/dev/sweet_s3706.c
+++ b/bsd/dev/sweet_s3706.c
@@ -29,6 +29,9 @@
  * wrapper-domain and M-event enables use their distinct 0xe1c/0x614
  * registers (never aliasing one another); each transfer follows the
  * vendor's length -> M_CMD0 -> DMA prep/final-LEN launch handshake;
+ * and before GENI takes the pads, a stuck physical I2C bus is released
+ * with the standard nine-SCL-pulse/STOP recovery and the base DT's
+ * exact qup17, 4 mA, bias-disable active pin state;
  * TLMM is reached through the south tile like
  * sweet_fts.c (same SoC, proven there). Coordinates are already panel
  * pixels (DTBO panel-coords = display-coords = 1080x2400).
@@ -660,6 +663,56 @@ tp_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, boo
 	tp_wr(st.gpio, off, cfg);
 }
 
+/*
+ * A13/A14 proved the complete command and DMA path: M and TX DMA are
+ * active and TX_LEN_IN consumes the full payload, but GENI_IOS says
+ * both SCL and SDA inputs are low forever. Recover the physical I2C
+ * bus before handing the pads to GENI: release both lines as GPIO
+ * inputs with pull-ups, pulse SCL at most nine times while SDA is
+ * released, then generate STOP (SDA low -> SCL high -> SDA high).
+ * Never drive a high level push-pull. Finally restore the exact base-
+ * DT active state: qup17 mux 1, bias disabled, 4 mA drive.
+ */
+static void
+tp_i2c_bus_recover(void)
+{
+	/* GPIO input + pull-up means open-drain release. */
+	tp_gpio(TP_PIN_SDA, 0, 3, 1, false, false);
+	tp_gpio(TP_PIN_SCL, 0, 3, 1, false, false);
+	delay(10);
+	uint32_t before_sda = tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SDA)) & 1u;
+	uint32_t before_scl = tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SCL)) & 1u;
+	unsigned pulses = 0;
+	while (!(tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SDA)) & 1u) && pulses < 9) {
+		/* SCL low, then release high. */
+		tp_gpio(TP_PIN_SCL, 0, 0, 1, true, false);
+		delay(5);
+		tp_gpio(TP_PIN_SCL, 0, 3, 1, false, false);
+		delay(5);
+		pulses++;
+	}
+	/* STOP: hold both low, release SCL, then release SDA. */
+	tp_gpio(TP_PIN_SCL, 0, 0, 1, true, false);
+	tp_gpio(TP_PIN_SDA, 0, 0, 1, true, false);
+	delay(5);
+	tp_gpio(TP_PIN_SCL, 0, 3, 1, false, false);
+	delay(5);
+	tp_gpio(TP_PIN_SDA, 0, 3, 1, false, false);
+	delay(10);
+	uint32_t after_sda = tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SDA)) & 1u;
+	uint32_t after_scl = tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SCL)) & 1u;
+	printf("SWEET S3706: I2C bus recovery: before sda/scl=%u/%u pulses=%u after=%u/%u\n",
+	    before_sda, before_scl, pulses, after_sda, after_scl);
+	/* Base DT qupv3_se17_i2c_active: qup17, 4 mA, bias-disable. */
+	tp_gpio(TP_PIN_SDA, 1, 0, 1, false, false);
+	tp_gpio(TP_PIN_SCL, 1, 0, 1, false, false);
+	printf("SWEET S3706: I2C active pins: sda cfg/io=%#x/%#x scl=%#x/%#x\n",
+	    tp_rd(st.gpio, TP_GPIO_CFG(TP_PIN_SDA)),
+	    tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SDA)),
+	    tp_rd(st.gpio, TP_GPIO_CFG(TP_PIN_SCL)),
+	    tp_rd(st.gpio, TP_GPIO_IO(TP_PIN_SCL)));
+}
+
 static bool
 tp_clocks(void)
 {
@@ -1210,8 +1263,7 @@ tp_thread(void *arg, wait_result_t result)
 	if (!tp_clocks()) {
 		goto out;
 	}
-	tp_gpio(TP_PIN_SDA, 1, 0, 0, false, false); /* qup17, 2 mA, no pull */
-	tp_gpio(TP_PIN_SCL, 1, 0, 0, false, false);
+	tp_i2c_bus_recover(); /* release a stuck slave, then qup17/4mA/no-pull */
 	if (!tp_se_init()) {
 		goto out;
 	}
