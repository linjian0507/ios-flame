+/* ---- RNDIS control protocol (sweetusbrndis=1) ------------------------
+ * Message formats and every OID answer mirror Linux drivers/usb/gadget/
+ * function/rndis.c (rndis_msg_parser, gen_ndis_query_resp/set_resp), the
+ * code every Android phone runs against this same Windows driver, so the
+ * host accepts it. Message types INIT 2 / HALT 3 / QUERY 4 / SET 5 /
+ * RESET 6 / KEEPALIVE 8, completions set bit 31; information buffers sit
+ * at message byte 8 + InformationBufferOffset, and QUERY_COMPLETE carries
+ * its data at offset 16 (24-byte header). The device signals a queued
+ * answer with the 8-byte notification {RESPONSE_AVAILABLE=1, 0} on the
+ * interrupt endpoint; the host then drains it with GET_ENCAPSULATED_
+ * RESPONSE (one answer at a time: the host serializes commands, and
+ * RESET drains, so one slot is enough). Runs from the event thread:
+ * nothing here may block.
+ */
+#define RNDIS_MSG_PACKET      0x00000001u
+#define RNDIS_MSG_INIT        0x00000002u
+#define RNDIS_MSG_HALT        0x00000003u
+#define RNDIS_MSG_QUERY       0x00000004u
+#define RNDIS_MSG_SET         0x00000005u
+#define RNDIS_MSG_RESET       0x00000006u
+#define RNDIS_MSG_KEEPALIVE   0x00000008u
+#define RNDIS_MSG_C           0x80000000u
+#define RNDIS_STATUS_SUCCESS          0x00000000u
+#define RNDIS_STATUS_NOT_SUPPORTED    0xc00000bbu
+#define RNDIS_OID_SUPPORTED_LIST      0x00010101u
+#define RNDIS_OID_HARDWARE_STATUS     0x00010102u
+#define RNDIS_OID_MEDIA_SUPPORTED     0x00010103u
+#define RNDIS_OID_MEDIA_IN_USE        0x00010104u
+#define RNDIS_OID_MAXIMUM_FRAME_SIZE  0x00010106u
+#define RNDIS_OID_LINK_SPEED          0x00010107u
+#define RNDIS_OID_TX_BUFFER_SPACE     0x00010108u
+#define RNDIS_OID_RX_BUFFER_SPACE     0x00010109u
+#define RNDIS_OID_TX_BLOCK_SIZE       0x0001010au
+#define RNDIS_OID_RX_BLOCK_SIZE       0x0001010bu
+#define RNDIS_OID_VENDOR_ID           0x0001010cu
+#define RNDIS_OID_VENDOR_DESCRIPTION  0x0001010du
+#define RNDIS_OID_CURRENT_PACKET_FILTER 0x0001010eu
+#define RNDIS_OID_DRIVER_VERSION      0x00010110u
+#define RNDIS_OID_MAXIMUM_TOTAL_SIZE  0x00010111u
+#define RNDIS_OID_MAC_OPTIONS         0x00010113u
+#define RNDIS_OID_MEDIA_CONNECT_STATUS 0x00010114u
+#define RNDIS_OID_MAX_SEND_PACKETS    0x00010115u
+#define RNDIS_OID_VENDOR_DRIVER_VERSION 0x00010116u
+#define RNDIS_OID_PHYSICAL_MEDIUM     0x00010202u
+#define RNDIS_OID_XMIT_OK             0x00020101u
+#define RNDIS_OID_RCV_OK              0x00020102u
+#define RNDIS_OID_XMIT_ERROR          0x00020103u
+#define RNDIS_OID_RCV_ERROR           0x00020104u
+#define RNDIS_OID_RCV_NO_BUFFER       0x00020105u
+#define RNDIS_OID_802_3_PERMANENT_ADDRESS 0x01010101u
+#define RNDIS_OID_802_3_CURRENT_ADDRESS   0x01010102u
+#define RNDIS_OID_802_3_MULTICAST_LIST    0x01010103u
+#define RNDIS_OID_802_3_MAXIMUM_LIST_SIZE 0x01010104u
+#define RNDIS_OID_802_3_MAC_OPTIONS       0x01010105u
+#define RNDIS_OID_802_3_RCV_ERROR_ALIGNMENT 0x01020101u
+#define RNDIS_OID_802_3_XMIT_ONE_COLLISION  0x01020102u
+#define RNDIS_OID_802_3_XMIT_MORE_COLLISIONS 0x01020103u
+
+/* the list we advertise, same set as the Linux gadget advertises */
+static const uint32_t rndis_oids_supported[] = {
+	RNDIS_OID_SUPPORTED_LIST, RNDIS_OID_HARDWARE_STATUS,
+	RNDIS_OID_MEDIA_SUPPORTED, RNDIS_OID_MEDIA_IN_USE,
+	RNDIS_OID_MAXIMUM_FRAME_SIZE, RNDIS_OID_LINK_SPEED,
+	RNDIS_OID_TX_BLOCK_SIZE, RNDIS_OID_RX_BLOCK_SIZE,
+	RNDIS_OID_VENDOR_ID, RNDIS_OID_VENDOR_DESCRIPTION,
+	RNDIS_OID_VENDOR_DRIVER_VERSION, RNDIS_OID_CURRENT_PACKET_FILTER,
+	RNDIS_OID_MAXIMUM_TOTAL_SIZE, RNDIS_OID_MEDIA_CONNECT_STATUS,
+	RNDIS_OID_PHYSICAL_MEDIUM,
+	RNDIS_OID_XMIT_OK, RNDIS_OID_RCV_OK, RNDIS_OID_XMIT_ERROR,
+	RNDIS_OID_RCV_ERROR, RNDIS_OID_RCV_NO_BUFFER,
+	RNDIS_OID_802_3_PERMANENT_ADDRESS, RNDIS_OID_802_3_CURRENT_ADDRESS,
+	RNDIS_OID_802_3_MULTICAST_LIST, RNDIS_OID_802_3_MAC_OPTIONS,
+	RNDIS_OID_802_3_MAXIMUM_LIST_SIZE,
+	RNDIS_OID_802_3_RCV_ERROR_ALIGNMENT, RNDIS_OID_802_3_XMIT_ONE_COLLISION,
+	RNDIS_OID_802_3_XMIT_MORE_COLLISIONS,
+};
+
+static uint32_t
+ud_rndis_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+	    (uint32_t)p[3] << 24;
+}
+
+static void
+ud_rndis_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+/* RESPONSE_AVAILABLE on the interrupt endpoint; coalesced while one is
+ * in flight, the completion re-sends the rest (like f_rndis notify_count). */
+static void
+ud_rndis_notify(void)
+{
+	uint8_t *n;
+
+	if (ud.notify_busy) {
+		ud.notify_again = true;
+		return;
+	}
+	n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	ud_rndis_put32(n, 1);                       /* RESPONSE_AVAILABLE */
+	ud_rndis_put32(n + 4, 0);
+	ud.notify_busy = true;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+static void
+ud_rndis_reply(uint32_t len)
+{
+	ud.resp_len = len;
+	ud.resp_ready = 1;
+	ud_rndis_notify();
+}
+
+/* answer one query OID into out (space reserved to the supported-list
+ * size); returns the answer length, or -1 for RNDIS_STATUS_NOT_SUPPORTED.
+ * Values are the Linux gadget's: medium 802.3 (0), connected, 480 Mbps in
+ * units of 100 bit/s, and the 802_3 address OIDs return the host's MAC,
+ * which is what the host then uses as its own (rndis_set_host_mac). */
+static int
+ud_rndis_query_data(uint32_t oid, uint8_t *out)
+{
+	static const uint8_t host_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+	static const char vendor[] = "Sweet iOS (RNDIS)";
+	uint32_t n = 0;
+
+	bzero(out, 4 * (sizeof(rndis_oids_supported) / sizeof(uint32_t)));
+	switch (oid) {
+	case RNDIS_OID_SUPPORTED_LIST:
+		n = sizeof(rndis_oids_supported);
+		for (unsigned i = 0; i < n / 4; i++) {
+			ud_rndis_put32(out + 4 * i, rndis_oids_supported[i]);
+		}
+		return (int)n;
+	case RNDIS_OID_HARDWARE_STATUS:
+	case RNDIS_OID_MEDIA_SUPPORTED:
+	case RNDIS_OID_MEDIA_IN_USE:
+	case RNDIS_OID_PHYSICAL_MEDIUM:
+	case RNDIS_OID_802_3_MAC_OPTIONS:
+	case RNDIS_OID_XMIT_ERROR:
+	case RNDIS_OID_RCV_ERROR:
+	case RNDIS_OID_RCV_NO_BUFFER:
+	case RNDIS_OID_802_3_RCV_ERROR_ALIGNMENT:
+	case RNDIS_OID_802_3_XMIT_ONE_COLLISION:
+	case RNDIS_OID_802_3_XMIT_MORE_COLLISIONS:
+		ud_rndis_put32(out, 0);
+		return 4;
+	case RNDIS_OID_MAXIMUM_FRAME_SIZE:
+	case RNDIS_OID_TX_BLOCK_SIZE:
+	case RNDIS_OID_RX_BLOCK_SIZE:
+		ud_rndis_put32(out, 1500);
+		return 4;
+	case RNDIS_OID_LINK_SPEED:
+		ud_rndis_put32(out, 4800000);       /* 480 Mbit/s / 100 */
+		return 4;
+	case RNDIS_OID_TX_BUFFER_SPACE:
+	case RNDIS_OID_RX_BUFFER_SPACE:
+		ud_rndis_put32(out, 65536);
+		return 4;
+	case RNDIS_OID_VENDOR_ID:
+		ud_rndis_put32(out, 0x1209);        /* pid.codes */
+		return 4;
+	case RNDIS_OID_VENDOR_DESCRIPTION:
+		n = sizeof(vendor) - 1;
+		memcpy(out, vendor, n);
+		return (int)n;
+	case RNDIS_OID_DRIVER_VERSION:
+	case RNDIS_OID_VENDOR_DRIVER_VERSION:
+		ud_rndis_put32(out, 1);
+		return 4;
+	case RNDIS_OID_CURRENT_PACKET_FILTER:
+		ud_rndis_put32(out, ud.rndis_filter);
+		return 4;
+	case RNDIS_OID_MAXIMUM_TOTAL_SIZE:
+		ud_rndis_put32(out, 1558);
+		return 4;
+	case RNDIS_OID_MAC_OPTIONS:
+		ud_rndis_put32(out, 0x12);          /* serialized RX, full duplex */
+		return 4;
+	case RNDIS_OID_MEDIA_CONNECT_STATUS:
+		ud_rndis_put32(out, 0);             /* connected */
+		return 4;
+	case RNDIS_OID_MAX_SEND_PACKETS:
+		ud_rndis_put32(out, 16);
+		return 4;
+	case RNDIS_OID_XMIT_OK:
+		ud_rndis_put32(out, (uint32_t)ud.tx_frames);
+		return 4;
+	case RNDIS_OID_RCV_OK:
+		ud_rndis_put32(out, (uint32_t)ud.rx_frames);
+		return 4;
+	case RNDIS_OID_802_3_PERMANENT_ADDRESS:
+	case RNDIS_OID_802_3_CURRENT_ADDRESS:
+		memcpy(out, host_mac, 6);
+		return 6;
+	case RNDIS_OID_802_3_MULTICAST_LIST:
+		ud_rndis_put32(out, 0xe0000000);    /* multicast base only */
+		return 4;
+	case RNDIS_OID_802_3_MAXIMUM_LIST_SIZE:
+		ud_rndis_put32(out, 1);
+		return 4;
+	default:
+		return -1;
+	}
+}
+
+/* one RNDIS control message arrived in the ep0 OUT data stage */
+static void
+ud_rndis_command(const uint8_t *m, uint32_t len)
+{
+	uint32_t type = ud_rndis_get32(m), reqid = ud_rndis_get32(m + 8);
+	uint8_t *r = ud.resp;
+
+	if (len < 8) {
+		return;
+	}
+	printf("SWEET USB: rndis msg %u len %u\n", type, len);
+	switch (type) {
+	case RNDIS_MSG_INIT:
+		bzero(r, 52);
+		ud_rndis_put32(r, RNDIS_MSG_INIT | RNDIS_MSG_C);
+		ud_rndis_put32(r + 4, 52);
+		ud_rndis_put32(r + 8, reqid);
+		ud_rndis_put32(r + 12, RNDIS_STATUS_SUCCESS);
+		ud_rndis_put32(r + 16, 1);                  /* MajorVersion */
+		ud_rndis_put32(r + 24, 1);                  /* connectionless */
+		ud_rndis_put32(r + 28, 0);                  /* medium 802.3 */
+		ud_rndis_put32(r + 32, 1);                  /* MaxPacketsPerTransfer */
+		ud_rndis_put32(r + 36, 1584);               /* MaxTransferSize */
+		ud_rndis_reply(52);
+		break;
+	case RNDIS_MSG_HALT:
+		ud.data_up = false;
+		break;                                      /* no response */
+	case RNDIS_MSG_QUERY: {
+		uint32_t oid = ud_rndis_get32(m + 12);
+		int n = len >= 28 ? ud_rndis_query_data(oid, r + 24) : -1;
+		ud_rndis_put32(r, RNDIS_MSG_QUERY | RNDIS_MSG_C);
+		ud_rndis_put32(r + 8, reqid);
+		if (n < 0) {
+			ud_rndis_put32(r + 4, 24);
+			ud_rndis_put32(r + 12, RNDIS_STATUS_NOT_SUPPORTED);
+			ud_rndis_put32(r + 16, 0);
+			ud_rndis_put32(r + 20, 0);
+			n = 0;
+		} else {
+			ud_rndis_put32(r + 4, 24 + (uint32_t)n);
+			ud_rndis_put32(r + 12, RNDIS_STATUS_SUCCESS);
+			ud_rndis_put32(r + 16, (uint32_t)n);
+			ud_rndis_put32(r + 20, 16);         /* data at 8+16 */
+		}
+		printf("SWEET USB: rndis query %08x -> %d B\n", oid, n);
+		ud_rndis_reply(24 + (uint32_t)n);
+		break;
+	}
+	case RNDIS_MSG_SET: {
+		uint32_t oid = ud_rndis_get32(m + 12);
+		uint32_t blen = ud_rndis_get32(m + 16);
+		uint32_t boff = ud_rndis_get32(m + 20);
+		const uint8_t *b = m + 8 + boff;
+		uint32_t status = RNDIS_STATUS_SUCCESS;
+
+		if (oid == RNDIS_OID_CURRENT_PACKET_FILTER && blen >= 4 &&
+		    8 + boff + 4 <= len) {
+			ud.rndis_filter = ud_rndis_get32(b);
+			printf("SWEET USB: rndis packet filter %08x\n", ud.rndis_filter);
+			if (ud.rndis_filter && !ud.data_up) {
+				ud.data_up = true;
+				ud_link_event(true);
+				printf("SWEET USB: rndis data path up\n");
+			}
+		} else if (oid == RNDIS_OID_802_3_MULTICAST_LIST) {
+			/* one multicast address: we accept all anyway */
+		} else {
+			status = RNDIS_STATUS_NOT_SUPPORTED;
+		}
+		ud_rndis_put32(r, RNDIS_MSG_SET | RNDIS_MSG_C);
+		ud_rndis_put32(r + 4, 16);
+		ud_rndis_put32(r + 8, reqid);
+		ud_rndis_put32(r + 12, status);
+		ud_rndis_reply(16);
+		break;
+	}
+	case RNDIS_MSG_RESET:
+		ud.data_up = false;
+		ud.rndis_filter = 0;
+		ud_rndis_put32(r, RNDIS_MSG_RESET | RNDIS_MSG_C);
+		ud_rndis_put32(r + 4, 16);
+		ud_rndis_put32(r + 8, RNDIS_STATUS_SUCCESS);
+		ud_rndis_put32(r + 12, 1);                  /* addressing reset */
+		ud_rndis_reply(16);
+		break;
+	case RNDIS_MSG_KEEPALIVE:
+		ud_rndis_put32(r, RNDIS_MSG_KEEPALIVE | RNDIS_MSG_C);
+		ud_rndis_put32(r + 4, 16);
+		ud_rndis_put32(r + 8, reqid);
+		ud_rndis_put32(r + 12, RNDIS_STATUS_SUCCESS);
+		ud_rndis_reply(16);
+		break;
+	default:
+		printf("SWEET USB: rndis unknown msg %u\n", type);
+		break;
+	}
 }
 
