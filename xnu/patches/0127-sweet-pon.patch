+
+/*
+ * One-byte write for the PMIC PON block. The ABL turns PON soft spare 0x88f
+ * into the boot mode it selects next, so the kernel writes the same "bootloader"
+ * reason the flame shim does. Only the PON peripheral is writable here, and
+ * only when the apps EE owns its APID (the write lane is EE-specific).
+ */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || sid != 0 || addr > 0xffffu || peripheral != 0x08) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+	if (owner != 0) {
+		printf("SWEET BATTERY: SPMI write %#x refused, APID %u owner %u\n",
+		    addr, apid, owner);
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	vm_offset_t ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+	if (ch == 0) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val; /* WDATA0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4; /* EXT_WRITEL */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = *(volatile uint32_t *)(ch + 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout addr=%#x APID=%u disabled\n",
+	    addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
