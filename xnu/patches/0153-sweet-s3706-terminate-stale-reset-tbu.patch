+/*
+ * Reset the TBU itself through its power domain - the same GDSC the
+ * vendor iommu regulator driver enables and disables the TBU with.
+ * The base DT blesses the disable with qcom,no-status-check-on-
+ * disable: a domain holding an outstanding request may never report
+ * OFF, so do not wait on it; the enable half is gdsc.c's recipe
+ * (de-assert collapse, poll power-on). If the domain does drop,
+ * this is a full reset of the TBU's internal state.
+ */
+static void
+tp_tbu_power_cycle(void)
+{
+	if (!st.gdsc) {
+		return;
+	}
+	uint32_t g2 = tp_rd(st.gdsc, GDSC_TBU2_OFF);
+	if (!(g2 & GDSC_PWR_ON)) {
+		return; /* tp_tbu_health already turned the domain on */
+	}
+	tp_wr(st.gdsc, GDSC_TBU2_OFF, g2 | GDSC_SW_COLLAPSE);
+	for (unsigned i = 0; i < 100 &&
+	    (tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON); ++i) {
+		delay(1000);
+	}
+	bool off = !(tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON);
+	tp_wr(st.gdsc, GDSC_TBU2_OFF, g2 & ~(GDSC_HW_CONTROL | GDSC_SW_COLLAPSE));
+	for (unsigned i = 0; i < 1000 &&
+	    !(tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON); ++i) {
+		delay(1000);
+	}
+	printf("SWEET S3706: tbu2 power cycle: collapsed=%d, now %#x (on=%u)\n",
+	    off ? 1 : 0, tp_rd(st.gdsc, GDSC_TBU2_OFF),
+	    (tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON) ? 1u : 0u);
+}
