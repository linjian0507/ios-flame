+/*
+ * Clear the stale fault state before the first request. In the last
+ * round our bank's fault record carried the same FSR value as USB's
+ * working bank - both predate this driver - and a context fault that
+ * was never reported and resumed leaves the bank stalled on its
+ * transaction: the vendor driver's own recovery for that is writing
+ * RESUME_TERMINATE to CB + 8 (arm-smmu.c fault and tbu-halt paths).
+ * Clear the global fault status too (write-1-to-clear), so what the
+ * timeout dump prints afterwards can only be this round's request.
+ */
+static void
+tp_smmu_reset_stale(void)
+{
+	if (!st.smmu || st.cbndx < 0) {
+		return;
+	}
+	uint32_t gfsr = tp_rd(st.smmu, AS_GFSR);
+	if (gfsr) {
+		tp_wr(st.smmu, AS_GFSR, gfsr);
+	}
+	uint32_t fsr = tp_rd(st.cb, CB_FSR);
+	if (fsr) {
+		tp_wr(st.cb, CB_FSR, fsr);
+	}
+	tp_wr(st.cb, CB_RESUME, CB_RESUME_TERM);
+	printf("SWEET S3706: cleared stale state: gfsr=%#x cb%d fsr=%#x, resume=terminate\n",
+	    gfsr, st.cbndx, fsr);
+}
