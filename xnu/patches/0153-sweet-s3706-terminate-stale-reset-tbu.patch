+/*
+ * This vendor's global register layout (arm-smmu-regs.h of the tree
+ * SM8150 runs, offsets from the SMMU base): sCR0 at 0 (fault routing:
+ * GFRE/GFIE/USFCFG bits decide who reports), sGFSR at 0x48 (global
