+ * a stalled bank is holding - the vendor fault/tbu-halt paths' own
+ * recovery. FSR at +0x58 is write-1-to-clear. */
+#define CB_RESUME       0x08u
+#define CB_RESUME_TERM  (1u << 0)
+#define CB_FSR          0x58u
 
