+/*
+ * Chunked upload: write exactly size bytes at off0, creating the file if
+ * needed and never truncating it. A host-side installer sends a large
+ * bundle in 1 MiB chunks, one connection each, so the USB receive path
+ * never has to hold a multi-megabyte stream.
+ */
+static int
+sf_put_at(socket_t so, const char *path, int mode, uint64_t off0, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t done = 0;
+	while (!err && done < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - done);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = rerr;
+			break;
+		}
+		int resid = 0;
+		err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)(off0 + done),
+		    UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		if (!err && resid) {
+			err = EIO;
+		}
+		done += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
