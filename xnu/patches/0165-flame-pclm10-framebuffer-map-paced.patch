+static unsigned sweet_fb_map_slot = ~0u;
+static unsigned sweet_fb_map_row;
+static unsigned sweet_fb_map_tick;
+
+/* Paced one row per two vsyncs so the 16 KiB console ring is not
+ * overwritten by SpringBoard's log bursts. */
+static void
+sweet_fb_map_emit(void)
+{
+	if (sweet_fb_map_slot == ~0u || ++sweet_fb_map_tick < 2) {
+		return;
+	}
+	sweet_fb_map_tick = 0;
+	if (sweet_fb_map_row >= 106) {
+		sweet_fb_map_slot = ~0u;
+		return;
+	}
+	static const char hex[] = "0123456789abcdef";
+	char line[48 * 2 + 32];
+	int pos = 0;
+	const uint8_t *src = sweet_fb_map_pixels + sweet_fb_map_row * 48;
+	for (unsigned i = 0; i < 48; i++) {
+		line[pos++] = hex[src[i] >> 4];
+		line[pos++] = hex[src[i] & 15];
+	}
+	line[pos] = 0;
+	IOLog("SWEET FB MAP %u %u %s\n", sweet_fb_map_slot,
+	    sweet_fb_map_row, line);
+	sweet_fb_map_row++;
+}
