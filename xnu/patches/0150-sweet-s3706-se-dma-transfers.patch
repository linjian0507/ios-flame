+static bool
+tp_dma_alloc(void)
+{
+	if (kmem_alloc_contig(kernel_map, &st.dma, TP_DMA_SIZE, PAGE_MASK, 0,
+	    0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET S3706: no contiguous DMA memory; stopping\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)st.dma);
+	if (!pn) {
+		printf("SWEET S3706: DMA page is not mapped; stopping\n");
+		return false;
+	}
+	st.dma_pa = ptoa_64(pn);
+	printf("SWEET S3706: DMA page pa=%#llx\n", st.dma_pa);
+	return true;
