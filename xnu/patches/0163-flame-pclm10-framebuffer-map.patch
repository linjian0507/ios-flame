diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 19d3ae4..c90182b 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -253,6 +253,43 @@ AppleCLCD::start(IOService *provider)
 
 static uint64_t sweet_fb_swap_count;
 
+/*
+ * Low-bandwidth screenshot for the serial log: sample the panel at
+ * 48x106 and emit RGB332 hex rows. The console ring is only 16 KiB, so
+ * two maps are spaced across the sample slots. Host-side reconstruction
+ * turns the rows back into a PNG; this reads the panel memory only.
+ */
+static void
+sweet_fb_dump_map(const uint8_t *pixels, uint32_t width, uint32_t height,
+    uint32_t row_bytes, unsigned slot)
+{
+	static int on = -1;
+	if (on < 0) {
+		on = 0;
+		PE_parse_boot_argn("sweetfb_map", &on, sizeof(on));
+	}
+	if (!on || pixels == 0 || width < 48 || height < 106) {
+		return;
+	}
+	static const char hex[] = "0123456789abcdef";
+	for (uint32_t gy = 0; gy < 106; gy++) {
+		char line[48 * 2 + 32];
+		int pos = 0;
+		uint32_t sy = (uint32_t)((uint64_t)gy * height / 106);
+		const volatile uint8_t *row = pixels + (uint64_t)sy * row_bytes;
+		for (uint32_t gx = 0; gx < 48; gx++) {
+			uint32_t sx = (uint32_t)((uint64_t)gx * width / 48);
+			const volatile uint8_t *p = row + (uint64_t)sx * 4;
+			uint8_t v = (uint8_t)((p[2] & 0xe0u) | ((p[1] >> 3) & 0x1cu) |
+			    ((p[0] >> 6) & 0x03u));
+			line[pos++] = hex[v >> 4];
+			line[pos++] = hex[v & 15];
+		}
+		line[pos] = 0;
+		IOLog("SWEET FB MAP %u %u %s\n", slot, gy, line);
+	}
+}
+
 /* Read-only paired samples for the opt-in CPU present diagnostic. They
  * compare the same source/panel coordinates away from corner mattes;
  * equal memory bytes do not establish what the physical panel shows. */
@@ -419,6 +456,10 @@ sweet_fb_sample_panel(uintptr_t pixels, uint32_t width, uint32_t height,
 			buf[pos] = 0;
 			IOLog("SWEET FB: sample %u line y=%u:%s\n", slot, y, buf);
 		}
+		if (slot >= 3) {
+			sweet_fb_dump_map((const uint8_t *)pixels, width, height,
+			    row_bytes, slot);
+		}
 		return;
 	}
 }
