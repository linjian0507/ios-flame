+/*
+ * Apps SMMU (MMU-500) and the SE17 DMA master's stream. The base DT
+ * ties i2c@0xc80000 to the qupv3_2 wrapper core, whose GENI-SE context
+ * bank is iommus = <&apps_smmu 0x7a3 0x0> with qcom,iommu-s1-bypass:
+ * the vendor runs this bus's DMA stage-1-bypassed, on physical
+ * addresses. ABL removes its stream-match entry when it leaves
+ * fastboot, and the SMMU faults unmatched streams - sweet_usb.c
+ * documents the identical recipe and failure for stream 0x140 (un-
+ * matched stream, first DMA, global fault, SoC reset: what the round
+ * with dtx=0x4 showed). Give 0x7a3 its own non-translating context
+ * bank, exactly the recipe sweet_usb.c proved on this device.
+ */
+#define AS_PA           0x15000000ULL
+#define AS_SIZE         0x100000
+#define SE_SID          0x7a3u
+
 static struct {
 	vm_offset_t se, gcc, gpio;
-	vm_offset_t dma;
+	vm_offset_t dma, smmu, cb;
 	uint64_t dma_pa;
 	bool started, dead, probing;
 	int log;
@@ -225,6 +244,87 @@ tp_dma_alloc(void)
