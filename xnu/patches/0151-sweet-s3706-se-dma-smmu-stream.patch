+/*
+ * Give the SE17 DMA master (stream 0x7a3) a working stream match, the
+ * sweet_usb.c recipe: if ABL left a match whose bank does no trans-
+ * lation, physical addresses pass through and we use it as is; other-
+ * wise program the first free stream-match register to the first free
+ * bank, programmed non-translating exactly like ABL's own DMA banks
+ * (SCTLR M=0, CBA2R AArch64, CBAR 0x1f000; a bypass S2CR type is
+ * refused by hypervisor policy, so the bypass lives in the bank).
+ */
+static bool
+tp_smmu_setup(void)
+{
+	st.smmu = ml_io_map(AS_PA, AS_SIZE);
+	if (!st.smmu) {
+		printf("SWEET S3706: apps SMMU mapping failed; stopping\n");
+		return false;
+	}
+	uint32_t idr0 = tp_rd(st.smmu, 0x20), idr1 = tp_rd(st.smmu, 0x24);
+	unsigned nsmr = idr0 & 0xff, ncb = idr1 & 0xff;
+	uint32_t pagesz = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	uint32_t cbbase = (1u << (((idr1 >> 28) & 7u) + 1)) * pagesz;
+	uint64_t used[2] = {0, 0};
+	int free_smr = -1, cb = -1;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t m = tp_rd(st.smmu, 0x800 + 4 * i);
+		uint32_t c = tp_rd(st.smmu, 0xc00 + 4 * i);
+		if (!(m >> 31)) {
+			if (free_smr < 0) {
+				free_smr = (int)i;
+			}
+			continue;
+		}
+		if (((c >> 16) & 3) == 0) {
+			used[(c & 0xff) / 64] |= 1ULL << ((c & 0xff) % 64);
+		}
+		if (((SE_SID ^ (m & 0x7fff)) & ~((m >> 16) & 0x7fff) & 0x7fff) == 0) {
+			unsigned cb0 = c & 0xff;
+			vm_offset_t cbv = st.smmu + cbbase + cb0 * pagesz;
+			if (((c >> 16) & 3) == 0 && !(tp_rd(cbv, 0) & 1)) {
+				st.cb = cbv;
+				printf("SWEET S3706: SMMU smr%u %x already matches %#x via cb%u "
+				    "(cbar %x sctlr %x: no translation, using it)\n",
+				    i, m, SE_SID, cb0,
+				    tp_rd(st.smmu, pagesz + 4 * cb0), tp_rd(cbv, 0));
+				return true;
+			}
+			printf("SWEET S3706: SMMU smr%u %x matches %#x via translating cb (s2cr %#x); stopping\n",
+			    i, m, SE_SID, c);
+			return false;
+		}
+	}
+	/* Lowest free bank, as Linux allocates: the top banks may be secure. */
+	for (int c = 0; c < (int)ncb; c++) {
+		if (!(used[c / 64] & (1ULL << (c % 64))) &&
+		    !(tp_rd(st.smmu, cbbase + (uint32_t)c * pagesz) & 1) &&
+		    tp_rd(st.smmu, pagesz + 4 * (uint32_t)c) == 0) {
+			cb = c;
+			break;
+		}
+	}
+	if (free_smr < 0 || cb < 0) {
+		printf("SWEET S3706: SMMU: no free smr/cb for stream %#x (smr %d cb %d); stopping\n",
+		    SE_SID, free_smr, cb);
+		return false;
+	}
+	vm_offset_t cbv = st.smmu + cbbase + (uint32_t)cb * pagesz;
+	tp_wr(st.smmu, cbv - st.smmu, 0xe0);                    /* SCTLR: M=0, like ABL */
+	tp_wr(st.smmu, pagesz + 0x800 + 4 * (uint32_t)cb, 1);  /* CBA2R: AArch64 */
+	tp_wr(st.smmu, pagesz + 4 * (uint32_t)cb, 0x1f000);    /* CBAR as ABL's banks */
+	tp_wr(st.smmu, 0xc00 + 4 * (uint32_t)free_smr, (uint32_t)cb);
+	tp_wr(st.smmu, 0x800 + 4 * (uint32_t)free_smr, (1u << 31) | SE_SID);
+	st.cb = cbv;
+	printf("SWEET S3706: SMMU smr%d %x s2cr %x -> cb%d cbar %x cba2r %x sctlr %x (no translation, as ABL)\n",
+	    free_smr, tp_rd(st.smmu, 0x800 + 4 * (uint32_t)free_smr),
+	    tp_rd(st.smmu, 0xc00 + 4 * (uint32_t)free_smr), cb,
+	    tp_rd(st.smmu, pagesz + 4 * (uint32_t)cb),
+	    tp_rd(st.smmu, pagesz + 0x800 + 4 * (uint32_t)cb),
+	    tp_rd(st.smmu, cbv - st.smmu));
+	return true;
+}
