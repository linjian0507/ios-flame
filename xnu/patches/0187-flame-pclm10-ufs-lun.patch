+/*
+ * Raw read from a UFS LUN, for partitions that have no GPT entry (the
+ * PCLM10 vendor image lives on a non-LUN0 unit). Reads are absolute LBA
+ * on that unit and read-only; the caller supplies the size.
+ */
+int
+sweet_ufs_read_lun(int lun, uint64_t off, void *buf, size_t len)
+{
+	uint8_t save_lun;
+	int error = 0;
+
+	if (len == 0) {
+		return 0;
+	}
+	if (lun < 0 || lun > 7) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	save_lun = su.lun;
+	su.lun = (uint8_t)lun;
+	for (size_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = (uint32_t)MIN((uint64_t)len - done,
+		    (uint64_t)BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(lba, blocks);
+		if (!error) {
+			memcpy((char *)buf + done,
+			    (const char *)(su.dma + DMA_BOUNCE) + skip, want);
+		}
+		done += want;
+	}
+	su.lun = save_lun;
 	lck_mtx_unlock(&sweet_ufs_lock);
 	return error;
 }
