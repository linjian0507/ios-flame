 /* Read-only owner query for the single PM8150L GPIO used by the PCLM10
  * touch panel. This never maps or submits to the write channel. */
 int
@@ -164,6 +169,91 @@ sweet_spmi_touch_gpio_owner(unsigned *apid_out, unsigned *owner_out)
 	return 0;
 }
 
+/*
+ * Drive the single PM8150L LV GPIO5 that the board overlay names as the
+ * PCLM10 touchpanel 1.8 V enable. Restrict the write channel to its exact
+ * register block, require apps-EE ownership, and require type/subtype LV
+ * before changing anything. The sequence is the vendor pinctrl driver's
+ * config_set order, with master enable last. Only this GPIO is writable.
+ */
+static uint8_t
+sp_touch_gpio_reg_value(uint16_t addr, int high)
+{
+	switch (addr) {
+	case 0xc441: return 0x00;      /* VIN0 */
+	case 0xc442: return 0x05;      /* bias disable */
+	case 0xc445: return 0x03;      /* CMOS, high strength */
+	case 0xc443: return 0x00;      /* no dtest */
+	case 0xc440: return 0x01;      /* digital output */
+	case 0xc444: return high ? 0x80 : 0x00; /* invert=level */
+	case 0xc446: return 0x80;      /* master enable */
+	default: return 0;
+	}
+}
+
+int
+sweet_spmi_touch_gpio_set(int high)
+{
+	static const uint16_t addr[] = {
+		0xc441, 0xc442, 0xc445, 0xc443, 0xc440, 0xc444, 0xc446,
+	};
+	uint8_t type = 0, subtype = 0;
+	if (!sp_ready) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((4u << 8) | 0xc4u);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+	if (owner != 0) {
+		printf("SWEET BATTERY: PM8150L GPIO5 write refused, APID %u owner %u\n",
+		    apid, owner);
+		IOLockUnlock(sp_lock);
+		return -2;
+	}
+	if (sp_read_locked(4, 0xc404, &type) || sp_read_locked(4, 0xc405, &subtype) ||
+	    type != 0x10 || subtype != 0x10) {
+		printf("SWEET BATTERY: PM8150L GPIO5 type=%#x subtype=%#x; refusing write\n",
+		    type, subtype);
+		IOLockUnlock(sp_lock);
+		return -3;
+	}
+	vm_offset_t ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+	if (ch == 0) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	for (unsigned i = 0; i < sizeof(addr) / sizeof(addr[0]); ++i) {
+		uint8_t value = sp_touch_gpio_reg_value(addr[i], high);
+		*(volatile uint32_t *)(ch + 0x10u) = value;
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(ch + 0x00u) = (addr[i] & 0xffu) << 4;
+		__asm__ volatile("dsb osh" ::: "memory");
+		bool done = false;
+		uint32_t status = 0;
+		for (unsigned n = 0; n < 1000; ++n) {
+			status = *(volatile uint32_t *)(ch + 0x08u);
+			if (status & 1u) {
+				done = true;
+				break;
+			}
+			delay(1);
+		}
+		if (!done || (status & 0x0eu)) {
+			sp_poisoned[apid] = true;
+			printf("SWEET BATTERY: PM8150L GPIO5 write %#x failed status=%#x\n",
+			    addr[i], status);
+			IOLockUnlock(sp_lock);
+			return -4;
+		}
+	}
+	IOLockUnlock(sp_lock);
+	return 0;
+}
