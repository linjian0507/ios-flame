@@ -525,17 +525,26 @@ static const uint8_t ud_cfg_desc[80] = {
  * composites always carry a second function for the same reason. The
  * ACM function needs no driver here: Windows either leaves it alone or
  * binds usbser to it, and neither touches the RNDIS child.
+ *
+ * The RNDIS function itself keeps Linux f_rndis's interface classes:
+ * the control interface is CDC ACM (02/02/01) and the data interface is
+ * CDC data (0A/00/00). Only the IAD carries EF/04/01, which is what
+ * rndiscmp.inf matches. The earlier descriptors put EF/04/01 on both
+ * interfaces; Windows built the composite and matched the function, but
+ * usb8023.sys failed to start (Code 10) before sending any RNDIS control
+ * message, which is what a driver that cannot find its data interface
+ * does.
  */
 static const uint8_t ud_cfg_desc_rndis[142] = {
 	9, 2, 142, 0, 4, 1, 0, 0x80, 250,                /* config: 4 interfaces, 500 mA */
 	8, 0x0b, 0, 2, 0xef, 0x04, 0x01, 0,             /* IAD: RNDIS, interfaces 0+1 */
-	9, 4, 0, 0, 1, 0xef, 0x04, 0x01, 5,             /* control interface: notification EP */
+	9, 4, 0, 0, 1, 0x02, 0x02, 0x01, 5,             /* control: CDC ACM vendor veneer */
 	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 (ignored) */
 	5, 0x24, 0x01, 0x00, 0x01,                      /* call management (ignored) */
 	4, 0x24, 0x02, 0x00,                            /* ACM capabilities (ignored) */
 	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
 	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes */
-	9, 4, 1, 0, 2, 0xef, 0x04, 0x01, 0,             /* data interface: two bulk, no altsetting */
+	9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,             /* data: CDC data, two bulk, no altsetting */
 	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
 	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
 	8, 0x0b, 2, 2, 0x02, 0x02, 0x00, 0,             /* IAD: CDC-ACM, interfaces 2+3 */
@@ -1328,7 +1337,10 @@ ud_if_detach(ifnet_t ifp __unused)
