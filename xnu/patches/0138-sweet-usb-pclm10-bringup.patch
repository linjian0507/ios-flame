+/*
+ * Debug aid for a board whose cmd-db resource names are not known yet:
+ * print the VRM table's keys (space padding shown as _, non-printable bytes
+ * as .) with their addresses. Read-only, bounded, called once from the PCLM10
+ * USB PHY bring-up when a rail lookup missed.
+ */
+void sweet_rpmh_dump_vrm(void);
+
+void
+sweet_rpmh_dump_vrm(void)
+{
+	if (rh_map() != 0) {
+		printf("SWEET RPMH: vrm dump: cmd-db not mapped\n");
+		return;
+	}
+	printf("SWEET RPMH: vrm dump: scanning cmd-db resource keys\n");
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != RH_VRM) {
+			continue;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if (!rh_range(entries, count * RH_DB_ENTRY)) {
+			printf("SWEET RPMH: vrm dump: malformed table %u\n", i);
+			return;
+		}
+		for (unsigned j = 0; j < count && j < 64; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			char name[9] = { 0 };
+			for (unsigned k = 0; k < 8; ++k) {
+				uint8_t ch = (uint8_t)(rh_read(rh_db, e + (k / 4) * 4) >> (8u * (k % 4)));
+				name[k] = (ch == ' ') ? '_' : ((ch >= 0x21 && ch < 0x7f) ? (char)ch : '.');
+			}
+			printf("SWEET RPMH: vrm[%u] %s addr=%#x\n", j, name, rh_read(rh_db, e + 16));
+		}
+	}
+}
