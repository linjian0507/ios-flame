+/*
+ * PCLM10: the stock ABL uses this controller for fastboot and may leave the
+ * power domain and the clocks off when it boots an OS normally (flame's
+ * EDK2 left them on, which is why this driver never needed any of this;
+ * measured 2026-11-08: with sweetusb=2 the host never saw even a connection,
+ * and the kernel returned to fastboot alive, i.e. the probe bailed out on
+ * the unpowered/unclocked check below). sweetusbbring=1 powers the domain
+ * and enables the gates first, the way Linux qcom_gdsc_enable and the clock
+ * gate driver do: GDSCR gets PWR_ON|BCR_RESET and is polled for PWR_ON; a
+ * gated CBCR gets CLK_OFF (and SLEEPWAKE) cleared and is polled for
+ * CLK_OFF. Every parent of these gates is an XO-derived or always-on
+ * config-NoC clock on this SoC, so no RCG programming is needed.
+ */
+static int
+usb_bring_up(vm_offset_t gcc)
+{
+	int i;
+
+	if (!(usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31))) {
+		*(volatile uint32_t *)(gcc + GCC_USB30_PRIM_GDSCR) = (1u << 31) | 1u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (i = 0; i < 2000; i++) {
+			if (usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31)) {
+				break;
+			}
+			delay(100);
+		}
+		printf("SWEET USB: bring: GDSC usb30_prim %s\n",
+		    (i < 2000) ? "powered on" : "FAILED to power on");
+		if (i >= 2000) {
+			return -1;
+		}
+	}
+	for (unsigned c = 0; c < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); c++) {
+		uint32_t v = usb_rd(gcc, usb_cbcr[c].off);
+		int j;
+
+		if (!(v & CBCR_CLK_OFF)) {
+			continue;
+		}
+		*(volatile uint32_t *)(gcc + usb_cbcr[c].off) =
+		    v & ~(CBCR_CLK_OFF | CBCR_SLEEPWAKE);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (j = 0; j < 200; j++) {
+			if (!(usb_rd(gcc, usb_cbcr[c].off) & CBCR_CLK_OFF)) {
+				break;
+			}
+			delay(100);
+		}
+		printf("SWEET USB: bring: clk %-12s %s\n", usb_cbcr[c].name,
+		    (j < 200) ? "enabled" : "FAILED to enable");
+		if (j >= 200) {
+			return -1;
+		}
+	}
+	return 0;
+}
