+/*
+ * PCLM10 DT hsphy@88e2000 supplies: pm8150_l5 (vdd, fixed 880 mV),
+ * pm8150_l12 (vdda18, 1800 mV), pm8150_l2 (vdda33, 3000 mV). The cmd-db
+ * resource names for this firmware are not known: try the plain names the
+ * Linux lpmh regulator driver uses for PM8150 LDOs, and if those miss also
+ * the space-padded spelling (rh_lookup zero-pads its key; a table that
+ * pads with spaces needs the other form), then dump the VRM table once so
+ * the real names reach the log. A miss is not fatal: behind the fastboot
+ * path we actually boot, ABL may well have left the rails voted, and the
+ * PHY register block is reachable through the phy-aux clock we enabled.
+ */
+static void
+ud_hsphy_power(void)
+{
+	static const struct { const char *res; unsigned mv; } rails[] = {
+		{ "l5", 880 }, { "l12", 1800 }, { "l2", 3000 },
+	};
+	bool missed = false;
+
+	for (unsigned r = 0; r < sizeof(rails) / sizeof(rails[0]); r++) {
+		bool ok = false;
+		for (int pad = 0; pad < 2 && !ok; pad++) {
+			char name[9];
+			snprintf(name, sizeof(name), pad ? "%-8s" : "%s", rails[r].res);
+			if (sweet_rpmh_vreg_enable(name, rails[r].mv) == 0) {
+				printf("SWEET USB: hsphy rail %s %u mV voted%s\n", name,
+				    rails[r].mv, pad ? " (space-padded key)" : "");
+				ok = true;
+			}
+		}
+		if (!ok) {
+			printf("SWEET USB: hsphy rail %s not voted (already on, or name unknown)\n",
+			    rails[r].res);
+			missed = true;
+		}
+	}
+	if (missed) {
+		sweet_rpmh_dump_vrm();
+	}
+}
