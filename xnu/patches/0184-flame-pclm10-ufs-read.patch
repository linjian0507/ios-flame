+/*
+ * Read-only raw view of a named GPT partition for the file server
+ * (bsd/dev/sweet_files.c). The caller's buffer is filled in bounce-sized
+ * chunks while sweet_ufs_lock excludes the mounted root I/O; su's
+ * userdata bounds are saved and restored around the GPT lookup.
+ */
+int
+sweet_ufs_read_partition(const char *name, uint64_t off, void *buf, size_t len)
+{
+	uint64_t save_first, save_n, first, n;
+	int error;
+
+	if (len == 0) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	save_first = su.first_block;
+	save_n = su.nblocks;
+	error = ufs_find_partition(name);
+	first = su.first_block;
+	n = su.nblocks;
+	su.first_block = save_first;
+	su.nblocks = save_n;
+	if (!error && (off > n * UFS_BLOCK || len > n * UFS_BLOCK - off)) {
+		error = EINVAL;
+	}
+	for (size_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = (uint32_t)MIN((uint64_t)len - done,
+		    (uint64_t)BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(first + lba, blocks);
+		if (!error) {
+			memcpy((char *)buf + done,
+			    (const char *)(su.dma + DMA_BOUNCE) + skip, want);
+		}
+		done += want;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
