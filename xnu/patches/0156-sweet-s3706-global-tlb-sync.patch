 #define AS_PA           0x15000000ULL
 #define AS_SIZE         0x100000
@@ -235,6 +242,10 @@ void sweet_s3706_init(void);
 #define AS_GFSYNR0      0x050u
 #define AS_GFSYNR1      0x054u
 #define AS_GFSYNR2      0x058u
+#define AS_TLBIALLNSNH  0x068u
+#define AS_TLBGSYNC     0x070u
+#define AS_TLBGSTATUS   0x074u
+#define AS_TLBG_ACTIVE  (1u << 0)
 #define AS_CBFRSYNRA    0x400u  /* plus 4 * bank, on top of GR1 */
 /* CB RESUME at +0x8: writing bit 0 (TERMINATE) drops the transaction
  * a stalled bank is holding - the vendor fault/tbu-halt paths' own
@@ -395,6 +406,25 @@ tp_smmu_setup(void)
 	tp_wr(st.smmu, cbv - st.smmu, 0xe0);                    /* SCTLR: M=0, like ABL */
 	tp_wr(st.smmu, pagesz + 0x800 + 4 * (uint32_t)cb, 1);  /* CBA2R: AArch64 */
 	tp_wr(st.smmu, pagesz + 4 * (uint32_t)cb, 0x1f000);    /* CBAR as ABL's banks */
+	/*
+	 * sweet_a6xx.c's proven SM8150 sequence: after programming the
+	 * context bank but before publishing S2CR/SMR, invalidate every
+	 * non-secure/non-hyp TLB entry and globally synchronize it. ABL
+	 * removed 0x7a3's match on exit; without this pulse an anoc_2 TBU
+	 * may retain that old unmatched/FAULT result even though the new
+	 * registers read back correctly - exactly the faultless silence
+	 * the last rounds measured.
+	 */
+	tp_wr(st.smmu, AS_TLBIALLNSNH, 0);
+	tp_wr(st.smmu, AS_TLBGSYNC, 0);
+	unsigned sync_ms = 0;
+	while ((tp_rd(st.smmu, AS_TLBGSTATUS) & AS_TLBG_ACTIVE) &&
+	    sync_ms < 10) {
+		delay(1000);
+		sync_ms++;
+	}
+	printf("SWEET S3706: SMMU global TLB invalidate/sync: status=%#x after %u ms\n",
+	    tp_rd(st.smmu, AS_TLBGSTATUS), sync_ms);
 	tp_wr(st.smmu, 0xc00 + 4 * (uint32_t)free_smr, (uint32_t)cb);
 	tp_wr(st.smmu, 0x800 + 4 * (uint32_t)free_smr, (1u << 31) | SE_SID);
 	st.cb = cbv;
