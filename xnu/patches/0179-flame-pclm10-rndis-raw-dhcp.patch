+ud_tx_frame_raw(const uint8_t *frame, uint32_t len)
+{
+	mbuf_t m = NULL;
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(m);
+		return;
+	}
+	mbuf_pkthdr_setlen(m, len);
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count < UD_TXQ) {
+		ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+		ud.txq_count++;
+		ud_tx_kick_locked();
+	} else {
+		mbuf_freem(m);
+	}
+	lck_mtx_unlock(ud.lock);
+}
