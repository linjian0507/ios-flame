  * options (message type, server id, lease, mask/router/DNS/broadcast)
  * are enough for the in-box DHCP client to take 192.168.7.1/24 and install
  * the connected route to 192.168.7.2.
+ *
+ * The reply is a complete Ethernet/IPv4/UDP frame sent through the RNDIS
+ * TX path, not through the socket stack: the host still has APIPA, so
+ * 192.168.7.255 is not one of its broadcast addresses, and the phone has
+ * no route to 255.255.255.255. A unicast frame to the host's chaddr with
+ * IP destination 255.255.255.255 is accepted before it has an address.
  */
+static uint16_t
+ud_ip_csum(const uint8_t *p, uint32_t n)
+{
+	uint32_t sum = 0;
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		sum += ((uint32_t)p[i] << 8) | p[i + 1];
+	}
+	if (n & 1) {
+		sum += (uint32_t)p[n - 1] << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
