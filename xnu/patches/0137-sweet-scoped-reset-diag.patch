diff --git a/iokit/IOKit/SweetResetDiagnostics.h b/iokit/IOKit/SweetResetDiagnostics.h
new file mode 100644
index 0000000..3ebc8bc
--- /dev/null
+++ b/iokit/IOKit/SweetResetDiagnostics.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+#ifndef _IOKIT_SWEET_RESET_DIAGNOSTICS_H
+#define _IOKIT_SWEET_RESET_DIAGNOSTICS_H
+
+#include <IOKit/IOPlatformExpert.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Set once in panic_init from sweetresetdiag=1; off by default. */
+extern int sweet_reset_diag_enabled;
+/* Implemented in osfmk/kern/printf.c; internal header is not exported to IOKit. */
+extern int kdb_printf_unbuffered(const char *format, ...)
+    __attribute__((format(printf, 1, 2)));
+#ifdef __cplusplus
+}
+#endif
+
+/* Never stop panic begin/sync/end, paging-off or diagnostic notifications. */
+static inline int
+sweet_reset_diag_should_stop(unsigned int type)
+{
+	if (!sweet_reset_diag_enabled) {
+		return 0;
+	}
+	switch (type) {
+	case kPEHaltCPU:
+	case kPERestartCPU:
+	case kPEHangCPU:
+	case kPEUPSDelayHaltCPU:
+	case kPEPanicRestartCPU:
+	case kPEPanicRestartCPUNoCallouts:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+#endif /* _IOKIT_SWEET_RESET_DIAGNOSTICS_H */
