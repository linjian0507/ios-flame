 #include <IOKit/pwr_mgt/RootDomain.h>
@@ -985,14 +988,10 @@ int
 PEHaltRestartInternal(unsigned int type, uint32_t details)
 {
 #if defined(ARM64_BOARD_CONFIG_SWEET)
-	/*
-	 * Diagnostic (PCLM10): every kernel-initiated halt/restart prints its
-	 * type and stops here, so the reason stays on screen instead of the
-	 * machine resetting. Types: 1 halt, 2 restart, 3 panic-diagnostics-done,
-	 * 4 panic-restart, 5 ups-delay, ...
-	 */
-	if (type != kPEUPSDelayHaltCPU) {
-		printf("SWEET HALT: PEHaltRestartInternal type=%u -- stopping\n", type);
+	/* Opt-in final-action gate; leave panic collection notifications alone. */
+	if (sweet_reset_diag_should_stop(type)) {
+		kdb_printf_unbuffered("SWEET RESET DIAG: terminal type=%u details=%#x caller=%p -- stopping\n",
+		    type, details, __builtin_return_address(0));
 		for (;;) {
 			__asm__ volatile("wfe" ::: "memory");
 		}
