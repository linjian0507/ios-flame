 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <IOKit/SweetResetDiagnostics.h>
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -241,6 +242,16 @@ SweetPlatformExpert::start(IOService *provider)
 {
 	sweet_log_mirror_start();       /* crash rescue: bsd/dev/sweet_ufs.c */
 	IOLog("SWEET: starting device-tree platform expert\n");
+	if (sweet_reset_diag_enabled) {
+		int selftest = 0;
+		IOLog("SWEET RESET DIAG: enabled (final actions only)\n");
+		PE_parse_boot_argn("sweetdiagpanic", &selftest, sizeof(selftest));
+		if (selftest == 1) {
+			panic("SWEET RESET DIAG: intentional self-test panic");
