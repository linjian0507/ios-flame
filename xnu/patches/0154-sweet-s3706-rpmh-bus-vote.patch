+/*
+ * Same dump for every table the lookup path accepts - VRM, ARC and BCM
+ * - so a path whose voter name is not known here can be named from
+ * the firmware's own resource list instead of guessed. Read-only,
+ * bounded, called once from the PCLM10 S3706 bring-up before its
+ * first bus vote.
+ */
+void sweet_rpmh_dump_db(void);
+
+void
+sweet_rpmh_dump_db(void)
+{
+	if (rh_map() != 0) {
+		printf("SWEET RPMH: db dump: cmd-db not mapped\n");
+		return;
+	}
+	printf("SWEET RPMH: cmd-db dump: all resource keys\n");
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != RH_VRM && slave != RH_ARC && slave != RH_BCM) {
+			continue;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if (!rh_range(entries, count * RH_DB_ENTRY)) {
+			printf("SWEET RPMH: db dump: malformed table %u\n", i);
+			return;
+		}
+		const char *kind = slave == RH_VRM ? "vrm" :
+		    (slave == RH_ARC ? "arc" : "bcm");
+		for (unsigned j = 0; j < count && j < 64; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			char name[9] = { 0 };
+			for (unsigned k = 0; k < 8; ++k) {
+				uint8_t ch = (uint8_t)(rh_read(rh_db, e + (k / 4) * 4) >> (8u * (k % 4)));
+				name[k] = (ch == ' ') ? '_' : ((ch >= 0x21 && ch < 0x7f) ? (char)ch : '.');
+			}
+			printf("SWEET RPMH: %s[%u] %s addr=%#x\n", kind, j, name,
+			    rh_read(rh_db, e + 16));
+		}
+	}
+}
