+/*
+ * The last thing the vendor TBU driver does for this path, and the
+ * only thing on this boot nobody has ever done: the base DT's
+ * anoc_2_tbu node carries qcom,msm-bus,vectors-KBps = <0xa1 0x273
+ * ...> - a NoC vote for the TBU's path to memory, which the vendor
+ * bus driver raises through RPMh and which gates exactly the segment
+ * the last rounds proved missing: the request is matched, translated
+ * (no fault anywhere), and never answered. The GPU driver proves the
+ * mechanism and the need on this device (gpu_bus_vote raises MC0/SH0
+ * because nothing else does); the TBU's own segment is the anoc_2
+ * side. The RPMh resource name for it is not known here, so print
+ * the firmware's own resource table once, then ask for the plausible
+ * names at top level: a lookup miss is a harmless refusal, a hit
+ * raises the clock (RPMh takes the maximum of all votes, and the GPU
+ * already raised the memory-side ones).
+ */
+static void
+tp_bus_vote(void)
+{
+	static const char *const names[] = { "MMC", "MF0", "MMO", "ANOC", "MMN" };
+	sweet_rpmh_dump_db();
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+		uint32_t off = 0, val = 1u << 30 | 1u << 29 | 0x3fffu << 14 | 0x3fffu;
+		int rc = sweet_rpmh_write(names[i], 1, &off, &val);
+		printf("SWEET S3706: bus vote %s -> %d\n", names[i], rc);
+	}
+}
