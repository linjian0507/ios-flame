+static void
+tp_swipe(void)
+{
+	/* Synthetic bottom-to-top swipe through the same HID path as real
+	 * touches; opt-in with s3706swipe=N seconds between swipes. */
+	for (unsigned i = 0; i < 25; i++) {
+		sweet_hid_touch(0, 1, 540, 2250 - (int)i * 60);
+		tp_wait(10);
+	}
+	sweet_hid_touch(0, 0, 540, 750);
+	printf("SWEET S3706: synthetic swipe for unattended UI capture\n");
+}
