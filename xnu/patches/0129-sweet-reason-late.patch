 #include "../../../bsd/dev/sweet_spmi.h"
 
+/*
+ * Mark the next boot as "bootloader": the IMEM restart cookie and the PMIC PON
+ * soft spare 0x88f that the ABL reads. Called only when a reset is intended
+ * (watchdog about to bite, or sweetreboot=N), never on a normal boot.
+ */
+static void
+sweet_mark_bootloader(void)
+{
+	volatile uint32_t *imem = (volatile uint32_t *)ml_io_map(0x146bf65cUL, 4);
+	if (imem != NULL) {
+		*imem = 0x77665500U;
+	}
+	if (sweet_spmi_init() == 0) {
+		uint8_t v = 0xff, after = 0xff;
+		if (sweet_spmi_read(0, 0x88f, &v) == 0) {
+			(void)sweet_spmi_write(0, 0x88f,
+			    (uint8_t)((v & 1u) | (0x02u << 1)));
+		}
+		if (sweet_spmi_read(0, 0x88f, &after) == 0) {
+			IOLog("SWEET REBOOT: PON spare %#x -> %#x\n", v, after);
+		}
+	}
+	IOLog("SWEET REBOOT: IMEM/PON restart reason=bootloader\n");
+}
+
