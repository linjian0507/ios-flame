+					ud_rndis_put32(ud.resp, RNDIS_MSG_INDICATE);
+					ud_rndis_put32(ud.resp + 4, 20);
+					ud_rndis_put32(ud.resp + 8, RNDIS_STATUS_MEDIA_CONNECT);
+					ud_rndis_put32(ud.resp + 12, 0);
+					ud_rndis_put32(ud.resp + 16, 0);
+					ud.resp_len = 20;
