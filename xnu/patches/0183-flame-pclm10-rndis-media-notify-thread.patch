 }
 
+/* 0178 queued MEDIA_CONNECT and called ud_rndis_notify() from the EP0
+ * GET handler; the shared event thread then stopped servicing the ACM
+ * serial console. Keep the queueing in EP0, but start the ep2 transfer
+ * from this separate thread. */
+static void
+ud_media_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		if (ud.media_notify) {
+			ud.media_notify = false;
+			ud_rndis_notify();
+			printf("SWEET USB: media connect notify (thread)\n");
+		}
+		ud_sleep_ms(20);
+	}
+}
+
+static void
+ud_media_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(ud_media_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static void
 ud_event(uint32_t ev)
 {
@@ -2505,6 +2551,7 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		sweet_files_start();    /* tcp 2223: bsd/dev/sweet_files.c */
 		if (ud.rndis) {
 			ud_dhcp_start();    /* host gets 192.168.7.1/24 */
+			ud_media_start();   /* ep2 MEDIA_CONNECT, off the EP0 thread */
 		}
 	}
 }
