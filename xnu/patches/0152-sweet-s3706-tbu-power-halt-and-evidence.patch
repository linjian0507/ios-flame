+/*
+ * The TBU that serves stream 0x7a3 must be powered and free of a
+ * debug halt to forward requests. The base DT names its power domain
+ * (qcom,gdsc@0x17d048, the domain only the vendor iommu regulator
+ * driver ever enables - nothing ran that here) and its ECATS debug
+ * halt register; the recipes are gdsc.c's (de-assert SW_COLLAPSE bit
+ * 0, poll PWR_ON bit 31) and the vendor arm-smmu.c tbu_resume (clear
+ * the halt request bit), both for this SoC generation. The proven
+ * TBU (anoc_1, carrying USB's 0x140) is read as the reference. This
+ * never fails the probe: its writes are the vendor's own recovery
+ * steps, and its prints are the evidence.
+ */
+static void
+tp_tbu_health(void)
+{
+	st.gdsc = ml_io_map(GDSC_PAGE_PA, 0x1000);
+	st.tbu = ml_io_map(TBU2_PA, 0x1000);
+	st.tbu_status = ml_io_map(TBU_STATUS_PA & ~0xfffULL, 0x1000);
+	if (!st.gdsc || !st.tbu || !st.tbu_status) {
+		printf("SWEET S3706: tbu/gdsc mapping failed gdsc=%#lx tbu=%#lx st=%#lx\n",
+		    (unsigned long)st.gdsc, (unsigned long)st.tbu,
+		    (unsigned long)st.tbu_status);
+		return;
+	}
+	uint32_t g1 = tp_rd(st.gdsc, GDSC_TBU1_OFF), g2 = tp_rd(st.gdsc, GDSC_TBU2_OFF);
+	printf("SWEET S3706: gdsc tbu1=%#x (on=%u) tbu2=%#x (on=%u hw=%u collapse=%u); "
+	    "tbu2 halt=%#x ack=%#x status=%#x (idle status is 1)\n",
+	    g1, (g1 & GDSC_PWR_ON) ? 1u : 0u, g2,
+	    (g2 & GDSC_PWR_ON) ? 1u : 0u, (g2 & GDSC_HW_CONTROL) ? 1u : 0u,
+	    (g2 & GDSC_SW_COLLAPSE) ? 1u : 0u,
+	    tp_rd(st.tbu, TBU_HALT_REG), tp_rd(st.tbu, TBU_HALT_ACK),
+	    tp_rd(st.tbu_status, (uint32_t)(TBU_STATUS_PA & 0xfff)));
+	/* Vendor arm-smmu.c tbu_resume: clear the debug halt request. */
+	uint32_t halt = tp_rd(st.tbu, TBU_HALT_REG);
+	if (halt & TBU_HALT_VAL) {
+		tp_wr(st.tbu, TBU_HALT_REG, halt & ~TBU_HALT_VAL);
+		printf("SWEET S3706: tbu2 was debug-halted; cleared, now halt=%#x ack=%#x\n",
+		    tp_rd(st.tbu, TBU_HALT_REG), tp_rd(st.tbu, TBU_HALT_ACK));
+	}
+	/* Vendor gdsc.c enable: de-assert software collapse, poll power-
+	 * on. gdsc-regulator.c refuses to touch a domain under hardware
+	 * control, but an hw-controlled domain reading as off here has
+	 * no voter (no RPMh path ran), so taking software control is the
+	 * only way to name it; log the difference. */
+	if (!(g2 & GDSC_PWR_ON)) {
+		tp_wr(st.gdsc, GDSC_TBU2_OFF,
+		    g2 & ~(GDSC_HW_CONTROL | GDSC_SW_COLLAPSE));
+		for (unsigned i = 0; i < 1000 &&
+		    !(tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON); ++i) {
+			delay(1);
+		}
+		printf("SWEET S3706: gdsc tbu2 was off; de-collapsed, now %#x (on=%u)\n",
+		    tp_rd(st.gdsc, GDSC_TBU2_OFF),
+		    (tp_rd(st.gdsc, GDSC_TBU2_OFF) & GDSC_PWR_ON) ? 1u : 0u);
+	}
+}
+
+/*
+ * A request timed out: let the SMMU say where it is stuck. The global
+ * fault registers (GBADDR/GBFWR/GBFR, sGBPA(FTR), nsGBPA(FTR)) name
+ * an unmatched stream or a global abort; the context bank's
+ * fsr/far/fsynr name a context fault; and a TBU status mirror that
+ * reads anything but 1 after the request means the TBU is stuck on
+ * it. All read-only, and the same evidence after an AHB_ERR.
+ */
+static void
+tp_smmu_dump(const char *why)
+{
+	if (!st.smmu) {
+		return;
+	}
+	printf("SWEET S3706: %s: smmu gbaddr %08x:%08x gbfwr %#x gbfr %#x "
+	    "sgbpa %#x/%#x nsgbpa %#x/%#x\n", why,
+	    tp_rd(st.smmu, 0x604), tp_rd(st.smmu, 0x600), tp_rd(st.smmu, 0x608),
+	    tp_rd(st.smmu, 0x60c), tp_rd(st.smmu, 0x680), tp_rd(st.smmu, 0x688),
+	    tp_rd(st.smmu, 0x6c0), tp_rd(st.smmu, 0x6c8));
+	if (st.cb) {
+		printf("SWEET S3706: %s: cb fsr=%#x far=%08x:%08x fsynr0=%#x fsynr1=%#x\n",
+		    why, tp_rd(st.cb, 0x58), tp_rd(st.cb, 0x64), tp_rd(st.cb, 0x60),
+		    tp_rd(st.cb, 0x68), tp_rd(st.cb, 0x6c));
+	}
+	if (st.tbu && st.tbu_status && st.gdsc) {
+		printf("SWEET S3706: %s: tbu2 halt=%#x ack=%#x status=%#x gdsc2=%#x\n",
+		    why, tp_rd(st.tbu, TBU_HALT_REG), tp_rd(st.tbu, TBU_HALT_ACK),
+		    tp_rd(st.tbu_status, (uint32_t)(TBU_STATUS_PA & 0xfff)),
+		    tp_rd(st.gdsc, GDSC_TBU2_OFF));
+	}
+}
