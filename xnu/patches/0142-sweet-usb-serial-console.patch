+/* One chunk out through the serial console pipe; false if the pipe is
+ * not usable right now (endpoint down, host has not opened the port,
+ * or the previous chunk is still in flight). One TRB in flight; the
+ * completion event clears slog_busy. The data sits in DMA memory until
+ * the host polls, so a host that opens the port late still receives
+ * everything from the current position. Never prints. */
+static bool
+ud_serial_send(const char *p, uint32_t n)
+{
+	bool sent = false;
+
+	lck_mtx_lock(ud.lock);
+	if (ud.slog_ready && !ud.slog_busy && ud.acm_dtr) {
+		memcpy((void *)(ud.dma + UD_SBUF), p, n);
+		ud_sync(UD_SBUF, n);
+		ud.slog_busy = true;
+		ud_start_trb(EP_SLOG, UD_TRB_SLOG, UD_SBUF, n, TRBCTL_NORMAL);
+		sent = true;
+	}
+	lck_mtx_unlock(ud.lock);
+	return sent;
+}
