+/* Does this DWC3 implement physical endpoint ep? A DEPCMD register of a
+ * non-existent endpoint reads all-ones, and its parameter registers do
+ * not hold what was written to them. (PCLM10: the endpoint count of
+ * this core is not stated in the DT, and experiment F proved the ACM
+ * descriptor's ep9 cannot be trusted; a descriptor may describe an
+ * endpoint the silicon does not have.) */
+static bool
+ud_ep_exists(unsigned ep)
+{
+	if (dwc_rd(DEPCMD(ep)) == 0xffffffffu) {
+		return false;
+	}
+	dwc_wr(DEPCMDPAR0(ep), 0xa5a5a5a5u);
+	bool ok = dwc_rd(DEPCMDPAR0(ep)) == 0xa5a5a5a5u;
+	dwc_wr(DEPCMDPAR0(ep), 0);
+	return ok;
+}
